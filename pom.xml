<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tibudget</groupId>
    <artifactId>tibu-collector-starter</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Tibu Collector Starter</name>
    <description>Official starter project for building a Tibu collector.</description>

    <properties>
        <!-- Tibu -->
        <tibu.api.version>0.66</tibu.api.version>
        <tibu.utils.version>0.28</tibu.utils.version>
        <tibu.test-utils.version>0.10</tibu.test-utils.version>

        <!-- Encoding -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Java -->
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <!-- Build output -->
        <collector.version.code>1</collector.version.code>
        <collector.default.locale>en</collector.default.locale>
        <collector.vendor>Tibu</collector.vendor>
        <r8.version>8.5.35</r8.version>

        <!-- Android -->
        <android.compile.sdk>35</android.compile.sdk>
        <android.min.api>26</android.min.api>
        <android.jar>${env.ANDROID_HOME}/platforms/android-${android.compile.sdk}/android.jar</android.jar>

    </properties>

    <scm>
        <connection>scm:git:https://github.com/tibudget/tibudget-collector-starter.git</connection>
        <developerConnection>scm:git:https://github.com/tibudget/tibudget-collector-starter.git</developerConnection>
        <url>https://github.com/tibudget/tibudget-collector-starter</url>
        <tag>HEAD</tag>
    </scm>

    <licenses>
        <license>
            <name>CC0 1.0 Universal</name>
            <url>https://creativecommons.org/publicdomain/zero/1.0/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <!-- R8 is a build tool, not a collector dependency. -->
    <pluginRepositories>
        <pluginRepository>
            <id>google</id>
            <url>https://dl.google.com/dl/android/maven2/</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
        <!-- The mandatory Tibu API, provided by the Tibu mobile app -->
        <dependency>
            <groupId>com.github.tibudget</groupId>
            <artifactId>tibudget-api</artifactId>
            <version>${tibu.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Optional utils provided by Tibu to make it easier and faster to build your collector -->
        <dependency>
            <groupId>com.github.tibudget</groupId>
            <artifactId>tibudget-collector-utils</artifactId>
            <version>${tibu.utils.version}</version>
        </dependency>

        <!-- Optional utils provided by Tibu to test your collector -->
        <dependency>
            <groupId>com.github.tibudget</groupId>
            <artifactId>tibudget-collector-test-utils</artifactId>
            <version>${tibu.test-utils.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <!-- Assemblies need the project JAR during prepare-package. -->
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>**/.gitkeep</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Specification-Title>Tibu Collector API</Specification-Title>
                            <Specification-Version>${tibu.api.version}</Specification-Version>
                            <Specification-Vendor>tibudget.com</Specification-Vendor>
                            <Implementation-Title>${project.name}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Implementation-VersionCode>${collector.version.code}</Implementation-VersionCode>
                            <Implementation-Vendor>${collector.vendor}</Implementation-Vendor>
                            <TiBudget-DefaultLocale>${collector.default.locale}</TiBudget-DefaultLocale>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-r8-input</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>assembly-unpack.xml</descriptor>
                                <descriptor>assembly-r8.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                    <execution>
                        <id>assemble-collector</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>assembly-tibu.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <id>dex-collector</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.android.tools.r8.R8</mainClass>
                    <includePluginDependencies>true</includePluginDependencies>
                    <executableDependency>
                        <groupId>com.android.tools</groupId>
                        <artifactId>r8</artifactId>
                    </executableDependency>
                    <arguments>
                        <argument>--release</argument>
                        <argument>--pg-conf</argument>
                        <argument>${project.basedir}/proguard-rules.pro</argument>
                        <argument>--lib</argument>
                        <argument>${android.jar}</argument>
                        <!-- Resolve host API references without adding its classes to the DEX. -->
                        <argument>--lib</argument>
                        <argument>${settings.localRepository}/com/github/tibudget/tibudget-api/${tibu.api.version}/tibudget-api-${tibu.api.version}.jar</argument>
                        <argument>--output</argument>
                        <argument>${project.build.directory}/${project.artifactId}-${project.version}-dex.jar</argument>
                        <argument>${project.build.directory}/${project.artifactId}-${project.version}-jar-for-r8.jar</argument>
                        <argument>--min-api</argument>
                        <argument>${android.min.api}</argument>
                    </arguments>
                    <classpathScope>runtime</classpathScope>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.android.tools</groupId>
                        <artifactId>r8</artifactId>
                        <version>${r8.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
